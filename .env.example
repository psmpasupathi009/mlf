MONGODB_URI=mongodb://127.0.0.1:27017/mlf
# Prisma reads DATABASE_URL (MONGODB_URI is unused).
# Local: mongodb://127.0.0.1:27017/mlf?maxPoolSize=20
# Atlas (Vercel): mongodb+srv://USER:PASS@CLUSTER/mlf
#   App appends serverless defaults if missing: serverSelectionTimeoutMS,
#   connectTimeoutMS, maxPoolSize=10, minPoolSize=0, maxIdleTimeMS.
# CRITICAL for deploy: Atlas → Network Access → Allow Access from Anywhere
#   (0.0.0.0/0). Vercel IPs are dynamic; without this the site flaps connect/fail.
DATABASE_URL=mongodb://127.0.0.1:27017/mlf?maxPoolSize=20

# 2Factor.in — OTP + transactional hearing SMS
TWO_FACTOR_API_KEY=
# OTP template name from 2factor dashboard (Send SMS OTP → AUTOGEN3)
TWO_FACTOR_TEMPLATE_NAME=mlf
TWO_FACTOR_SENDER_ID=MLFPSM
# Hearing SMS uses ADDON_SERVICES/SEND/TSMS with OPEN_TEMPLATE.
# Enable "Open Template" on the sender in 2Factor, or switch to a DLT-approved fixed template.

JWT_SECRET=change-me-to-a-long-random-string
# Bootstrap admin only (10-digit or 91XXXXXXXXXX). Sub-admins are created in-app by admin.
ADMIN_MOBILE=91XXXXXXXXXX
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Daily client hearing SMS cron (Vercel Cron GET + manual/external POST)
# Auth via header only: Authorization: Bearer <CRON_SECRET> or x-cron-secret
# Generate a long random string. Required in production for /api/v1/cron/hearing-sms
CRON_SECRET=change-me-cron-secret-long-random

# Optional: enable in-memory SSE notification push (local single-node only)
# NEXT_PUBLIC_ENABLE_SSE=1
cd mlf && npm run db:seed