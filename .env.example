# Prisma reads DATABASE_URL — sign in to MongoDB Atlas, copy your
# mongodb+srv connection string, paste here. Check with: npm run db:ping
DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/mlf

# 2Factor.in — OTP + transactional hearing SMS
TWO_FACTOR_API_KEY=
# OTP template name from 2factor dashboard (Send SMS OTP → AUTOGEN3)
TWO_FACTOR_TEMPLATE_NAME=mlf
TWO_FACTOR_SENDER_ID=MLFPSM
# Hearing SMS uses ADDON_SERVICES/SEND/TSMS with OPEN_TEMPLATE.
# Enable "Open Template" on the sender in 2Factor, or switch to a DLT-approved fixed template.

JWT_SECRET=change-me-to-a-long-random-string
# Bootstrap super-admin (10-digit or 91XXXXXXXXXX). Sub-admins are created in-app.
# Development (NODE_ENV=development): seed/check-mobile may set PIN from SEED_PIN when unset.
# Production: env admin has no auto-PIN — first login uses OTP setup (strong PIN required).
# SEED_PIN=123456
SUPER_ADMIN_MOBILE=91XXXXXXXXXX
# Legacy alias if SUPER_ADMIN_MOBILE is unset
ADMIN_MOBILE=91XXXXXXXXXX
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Daily client hearing SMS cron (Vercel Cron GET + manual/external POST)
# Auth via header only: Authorization: Bearer <CRON_SECRET> or x-cron-secret
# Generate a long random string. Required in production for /api/cron/hearing-sms
CRON_SECRET=change-me-cron-secret-long-random

# Hours before scheduledAt when Confirm coming appears (client + office). Default 1.
APPOINTMENT_CONFIRM_WINDOW_HOURS=1

# Cloudinary — private/authenticated uploads (documents + avatars). Required.
# Mongo stores public_id only; bytes never go in the database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mlf
